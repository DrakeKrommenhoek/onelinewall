# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.

# Password for /admin (hide/delete pitches, set this week's prompt, export CSVs).
ADMIN_PASSWORD=

# Upstash Redis. Connecting an Upstash database in Vercel's Storage tab fills these in automatically.
# Without them the site runs on in-memory storage, which resets whenever the server restarts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. The public URL the QR code points to. Defaults to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=

# Optional. Hero video URL. Defaults to /media/commons-timelapse.mp4
NEXT_PUBLIC_HERO_VIDEO=
